# ── Supabase ──────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Project Settings → API → service_role (server-only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── The two fixed partner accounts (created manually in Supabase Auth) ─
# Used by seed scripts / reference only — actual login is Supabase Auth.
PARTNER_A_EMAIL=jay@grindcourt.app
PARTNER_B_EMAIL=partner@grindcourt.app

# ── Web push (VAPID) ─────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@samandjaytech.com

# ── AI provider ──────────────────────────────────────────────────────
# "gemini" (free tier, default) or "anthropic"
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── Cron ─────────────────────────────────────────────────────────────
# Shared secret checked against the Authorization: Bearer header on
# /api/cron/scan so only your cron caller can trigger violation scans.
CRON_SECRET=

# ── Violation detection tuning ───────────────────────────────────────
# Hour (0-23, server local time) after which task/log activity counts
# as "late night" for the late_night_activity violation.
LATE_NIGHT_CUTOFF_HOUR=23
